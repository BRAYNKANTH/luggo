# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayHere (Sri Lanka payment gateway)
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
NEXT_PUBLIC_PAYHERE_SANDBOX=true

# Text.lk SMS Gateway (Required for Production SMS Notifications)
TEXTLK_API_TOKEN=your-textlk-api-token
TEXTLK_SENDER_ID=Luggo

# Gmail SMTP via Nodemailer (Required for Production Email Notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# [DEPRECATED / UNUSED] Unused legacy Twilio/Resend parameters, code has migrated to Text.lk & Gmail Nodemailer
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+94xxxxxxxxx
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@luggo.lk

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
